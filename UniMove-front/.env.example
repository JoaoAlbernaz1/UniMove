# URL da API do UniMove-back. No emulador Android use http://10.0.2.2:3000/api/v1;
# em celular físico, o IP da máquina na rede (ex.: http://192.168.0.10:3000/api/v1).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Domínios de e-mail institucional aceitos (UC01 RN04). Igual ao
# ALLOWED_INSTITUTIONAL_EMAIL_DOMAINS do backend.
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAINS=ucb.edu.br
