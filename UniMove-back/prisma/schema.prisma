generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  PASSENGER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DEACTIVATED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RideStatus {
  SCHEDULED
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  RIDE_REQUEST_RECEIVED
  RIDE_REQUEST_ACCEPTED
  RIDE_REQUEST_REJECTED
  RIDE_REQUEST_EXPIRED
  RIDE_CANCELLED
  RIDE_STARTED
  RIDE_COMPLETED
  MESSAGE_RECEIVED
  INCIDENT_UPDATED
  SYSTEM
}

enum ProfileVisibility {
  UNIVERSITY
  CONFIRMED
}

enum IncidentType {
  INAPPROPRIATE_BEHAVIOR
  NO_SHOW
  VEHICLE_ISSUE
  SAFETY_CONCERN
  OTHER
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AcademicVerificationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id                            String                      @id @default(uuid()) @db.Uuid
  fullName                      String                      @map("full_name")
  studentNumber                 String?                     @unique @map("student_number") @db.VarChar(10)
  course                        String?
  semester                      Int?
  bio                           String?
  tags                          String[]                    @default([])
  profileCompletedAt            DateTime?                   @map("profile_completed_at") @db.Timestamptz(3)
  cpf                           String                      @unique
  institutionalEmail            String                      @unique @map("institutional_email")
  phone                         String?                     @map("phone")
  passwordHash                  String                      @map("password_hash")
  termsAcceptedAt               DateTime?                   @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion                  String?                     @map("terms_version")
  privacyPolicyVersion          String?                     @map("privacy_policy_version")
  status                        UserStatus                  @default(ACTIVE)
  createdAt                     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                     DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  roles                         UserRole[]
  vehicles                      Vehicle[]
  driverLicense                 DriverLicense?
  profilePhoto                  ProfilePhoto?
  academicVerification          AcademicVerification?
  academicVerificationsReviewed AcademicVerification[]      @relation("AcademicVerificationReviewer")
  routeTemplates                RouteTemplate[]
  drivenRides                   Ride[]                      @relation("RideDriver")
  rideRequests                  RideRequest[]
  reservations                  RideReservation[]
  ratingsGiven                  Rating[]                    @relation("RatingReviewer")
  ratingsReceived               Rating[]                    @relation("RatingReviewed")
  notifications                 Notification[]
  messageConversations          MessageConversation[]       @relation("ConversationPassenger")
  sentChatMessages              ChatMessage[]
  incidentsReported             Incident[]                  @relation("IncidentReporter")
  incidentsAgainst              Incident[]                  @relation("IncidentReportedUser")
  cancellations                 Cancellation[]
  auditLogs                     AuditLog[]
  refreshSessions               RefreshSession[]
  notificationPreferences       NotificationPreference?
  privacyPreferences            PrivacyPreference?
  pushDevices                   PushDevice[]
  blockedUsers                  UserBlock[] @relation("BlockedUsers")
  blockedByUsers                UserBlock[] @relation("BlockedByUsers")
  dataExportRequests            DataExportRequest[]
  twoFactor                     TwoFactorAuth?

  adminAccess                   AdminAccess?                @relation("AdminAccessAccount")
  adminAccessGranted            AdminAccess[]               @relation("AdminAccessGrantedBy")
  adminInvitesSent              AdminInvite[]               @relation("AdminInviteAuthor")
  adminInvitesReceived          AdminInvite[]               @relation("AdminInviteAccount")
  adminInvitesRevoked           AdminInvite[]               @relation("AdminInviteRevoker")
  adminPasswordResets           AdminPasswordReset[]
  adminMfaRecoveries            AdminMfaRecovery[]          @relation("AdminRecoverySubject")
  adminMfaRecoveriesReviewed    AdminMfaRecovery[]          @relation("AdminRecoveryReviewer")

  @@map("users")
}

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  name  RoleName   @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  tokenHash    String          @map("token_hash")
  familyId     String          @map("family_id") @db.Uuid
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?       @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  replacedById String?         @unique @map("replaced_by_id") @db.Uuid
  userAgent    String?         @map("user_agent")
  scope        SessionScope    @default(APP)
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy   RefreshSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshSession? @relation("SessionRotation")

  @@index([userId, familyId])
  @@map("refresh_sessions")
}

model DriverLicense {
  userId    String   @id @map("user_id") @db.Uuid
  image     Bytes
  mimeType  String   @default("image/jpeg") @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_licenses")
}

model ProfilePhoto {
  userId    String   @id @map("user_id") @db.Uuid
  image     Bytes
  mimeType  String   @default("image/jpeg") @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

model AcademicVerification {
  userId       String                     @id @map("user_id") @db.Uuid
  reportGuid   String                     @unique @map("report_guid") @db.VarChar(36)
  status       AcademicVerificationStatus @default(PENDING_REVIEW)
  submittedAt  DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt   DateTime?                  @map("reviewed_at") @db.Timestamptz(3)
  reviewedById String?                    @map("reviewed_by_id") @db.Uuid
  reviewNote   String?                    @map("review_note") @db.VarChar(500)
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                      @relation("AcademicVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@map("academic_verifications")
}

model Vehicle {
  id                String          @id @default(uuid()) @db.Uuid
  ownerId           String          @map("owner_id") @db.Uuid
  brand             String
  model             String
  color             String
  plate             String          @unique
  year              Int
  passengerCapacity Int             @map("passenger_capacity")
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  routeTemplates    RouteTemplate[]
  rides             Ride[]

  @@index([ownerId, active])
  @@map("vehicles")
}

model Location {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @unique
  type             String          @default("REGION")
  latitude         Float?
  longitude        Float?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  origins          RouteTemplate[] @relation("RouteOrigin")
  destinations     RouteTemplate[] @relation("RouteDestination")
  rideOrigins      Ride[]          @relation("RideOrigin")
  rideDestinations Ride[]          @relation("RideDestination")

  @@map("locations")
}

model RouteTemplate {
  id                    String                 @id @default(uuid()) @db.Uuid
  driverId              String                 @map("driver_id") @db.Uuid
  vehicleId             String                 @map("vehicle_id") @db.Uuid
  originLocationId      String                 @map("origin_location_id") @db.Uuid
  destinationLocationId String                 @map("destination_location_id") @db.Uuid
  departureTime         String                 @map("departure_time") @db.VarChar(5)
  timezone              String                 @default("America/Sao_Paulo")
  availableSeats        Int                    @map("available_seats")
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  driver                User                   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle               Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  originLocation        Location               @relation("RouteOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location               @relation("RouteDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  weekdays              RouteTemplateWeekday[]
  rides                 Ride[]

  @@index([originLocationId, destinationLocationId, active])
  @@map("route_templates")
}

model RouteTemplateWeekday {
  routeTemplateId String        @map("route_template_id") @db.Uuid
  weekday         Weekday
  routeTemplate   RouteTemplate @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)

  @@id([routeTemplateId, weekday])
  @@map("route_template_weekdays")
}

model Ride {
  id                    String                @id @default(uuid()) @db.Uuid
  routeTemplateId       String                @map("route_template_id") @db.Uuid
  driverId              String                @map("driver_id") @db.Uuid
  vehicleId             String                @map("vehicle_id") @db.Uuid
  originLocationId      String                @map("origin_location_id") @db.Uuid
  destinationLocationId String                @map("destination_location_id") @db.Uuid
  departureAt           DateTime              @map("departure_at") @db.Timestamptz(3)
  totalSeats            Int                   @map("total_seats")
  pricePerPersonCents   Int                   @default(0) @map("price_per_person_cents")
  additionalInfo        String?               @map("additional_info") @db.VarChar(1000)
  acceptsLuggage        Boolean               @default(true) @map("accepts_luggage")
  allowsMusic           Boolean               @default(false) @map("allows_music")
  acceptsPets           Boolean               @default(false) @map("accepts_pets")
  availableSeats        Int                   @map("available_seats")
  status                RideStatus            @default(OPEN)
  startedAt             DateTime?             @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  routeTemplate         RouteTemplate         @relation(fields: [routeTemplateId], references: [id], onDelete: Restrict)
  driver                User                  @relation("RideDriver", fields: [driverId], references: [id], onDelete: Restrict)
  vehicle               Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  originLocation        Location              @relation("RideOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location              @relation("RideDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  requests              RideRequest[]
  reservations          RideReservation[]
  conversations         MessageConversation[]
  cancellations         Cancellation[]
  ratings               Rating[]
  incidents             Incident[]

  @@unique([routeTemplateId, departureAt])
  @@index([status, departureAt])
  @@map("rides")
}

model RideRequest {
  id             String            @id @default(uuid()) @db.Uuid
  rideId         String            @map("ride_id") @db.Uuid
  passengerId    String            @map("passenger_id") @db.Uuid
  seatsRequested Int               @map("seats_requested")
  status         RideRequestStatus @default(PENDING)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  respondedAt    DateTime?         @map("responded_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  ride           Ride              @relation(fields: [rideId], references: [id], onDelete: Restrict)
  passenger      User              @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  reservation    RideReservation?

  @@index([rideId, status])
  @@index([passengerId, status])
  @@map("ride_requests")
}

model RideReservation {
  id            String            @id @default(uuid()) @db.Uuid
  rideId        String            @map("ride_id") @db.Uuid
  passengerId   String            @map("passenger_id") @db.Uuid
  requestId     String            @unique @map("request_id") @db.Uuid
  seats         Int
  status        ReservationStatus @default(CONFIRMED)
  confirmedAt   DateTime          @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt   DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  ride          Ride              @relation(fields: [rideId], references: [id], onDelete: Restrict)
  passenger     User              @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  request       RideRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  cancellations Cancellation[]

  @@index([rideId, status])
  @@index([passengerId, status])
  @@map("ride_reservations")
}

model MessageConversation {
  id          String        @id @default(uuid()) @db.Uuid
  rideId      String        @map("ride_id") @db.Uuid
  passengerId String        @map("passenger_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  ride        Ride          @relation(fields: [rideId], references: [id], onDelete: Restrict)
  passenger   User          @relation("ConversationPassenger", fields: [passengerId], references: [id], onDelete: Restrict)
  messages    ChatMessage[]

  @@unique([rideId, passengerId])
  @@index([passengerId, updatedAt])
  @@map("message_conversations")
}

model ChatMessage {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  senderId       String              @map("sender_id") @db.Uuid
  content        String              @db.VarChar(2000)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt         DateTime?           @map("read_at") @db.Timestamptz(3)
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt, id])
  @@index([conversationId, readAt])
  @@map("chat_messages")
}

model Cancellation {
  id                String           @id @default(uuid()) @db.Uuid
  rideId            String           @map("ride_id") @db.Uuid
  reservationId     String?          @map("reservation_id") @db.Uuid
  cancelledByUserId String           @map("cancelled_by_user_id") @db.Uuid
  reason            String
  details           String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  ride              Ride             @relation(fields: [rideId], references: [id], onDelete: Restrict)
  reservation       RideReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  cancelledBy       User             @relation(fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  @@map("cancellations")
}

model Rating {
  id             String   @id @default(uuid()) @db.Uuid
  rideId         String   @map("ride_id") @db.Uuid
  reviewerId     String   @map("reviewer_id") @db.Uuid
  reviewedUserId String   @map("reviewed_user_id") @db.Uuid
  score          Int
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  ride           Ride     @relation(fields: [rideId], references: [id], onDelete: Restrict)
  reviewer       User     @relation("RatingReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedUser   User     @relation("RatingReviewed", fields: [reviewedUserId], references: [id], onDelete: Restrict)

  @@unique([rideId, reviewerId, reviewedUserId])
  @@map("ratings")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  title        String
  message      String
  resourceType String?          @map("resource_type")
  resourceId   String?          @map("resource_id") @db.Uuid
  metadata     Json?
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  enabled         Boolean  @default(true)
  rideRequests    Boolean  @default(true) @map("ride_requests")
  confirmations   Boolean  @default(true)
  reminderMinutes Int      @default(30) @map("reminder_minutes")
  chatMessages    Boolean  @default(true) @map("chat_messages")
  payments        Boolean  @default(true)
  safety          Boolean  @default(true)
  promotions      Boolean  @default(false)
  push            Boolean  @default(true)
  email           Boolean  @default(true)
  sms             Boolean  @default(false)
  doNotDisturb    Boolean  @default(true) @map("do_not_disturb")
  quietStart      String   @default("22:00") @map("quiet_start") @db.VarChar(5)
  quietEnd        String   @default("07:00") @map("quiet_end") @db.VarChar(5)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PrivacyPreference {
  userId              String           @id @map("user_id") @db.Uuid
  profileVisibility   ProfileVisibility @default(UNIVERSITY) @map("profile_visibility")
  courseSemester      Boolean          @default(true) @map("course_semester")
  ratings             Boolean          @default(true)
  phoneSharing        Boolean          @default(false) @map("phone_sharing")
  realTimeLocation    Boolean          @default(true) @map("real_time_location")
  frequentLocations   Boolean          @default(true) @map("frequent_locations")
  consentUpdatedAt    DateTime         @default(now()) @map("consent_updated_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_preferences")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  blocker   User     @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("push_devices")
}

model TwoFactorAuth {
  userId      String   @id @map("user_id") @db.Uuid
  secret      String
  enabled     Boolean  @default(false)
  recoveryCodes String[] @default([]) @map("recovery_codes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

enum DataExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model DataExportRequest {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      DataExportStatus @default(PENDING)
  format      String           @default("JSON") @db.VarChar(10)
  error       String?
  requestedAt DateTime         @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@map("data_export_requests")
}

model Incident {
  id             String         @id @default(uuid()) @db.Uuid
  rideId         String         @map("ride_id") @db.Uuid
  reportedById   String         @map("reported_by_id") @db.Uuid
  reportedUserId String?        @map("reported_user_id") @db.Uuid
  type           IncidentType
  description    String
  status         IncidentStatus @default(OPEN)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime?      @map("resolved_at") @db.Timestamptz(3)
  ride           Ride           @relation(fields: [rideId], references: [id], onDelete: Restrict)
  reportedBy     User           @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  reportedUser   User?          @relation("IncidentReportedUser", fields: [reportedUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("incidents")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Gestão de identidade administrativa (IAM do painel).
// Nenhuma destas tabelas é lida pelo aplicativo dos estudantes.
// ---------------------------------------------------------------------------

/// Origem da sessão: o app usa o padrão APP; só a sessão do painel marca ADMIN.
enum SessionScope {
  APP
  ADMIN
}

enum AdminPermission {
  MANAGE_ADMINS
  MANAGE_USERS
  REVIEW_VERIFICATIONS
  MODERATE_INCIDENTS
  VIEW_REPORTS
  VIEW_AUDIT
}

enum AdminInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum AdminRecoveryStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

/// Permissões concedidas a uma conta com papel ADMIN. A ausência de linha é
/// deliberadamente equivalente a nenhuma permissão: quem gerencia acessos
/// precisa ter sido autorizado explicitamente.
model AdminAccess {
  userId      String            @id @map("user_id") @db.Uuid
  permissions AdminPermission[] @default([])
  grantedById String?           @map("granted_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User              @relation("AdminAccessAccount", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?             @relation("AdminAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@map("admin_access")
}

/// Convite para uma conta administrativa. `tokenHash` guarda só o SHA-256 do
/// token entregue por e-mail; o token em claro nunca é persistido nem logado.
model AdminInvite {
  id               String            @id @default(uuid()) @db.Uuid
  email            String
  fullName         String            @map("full_name")
  tokenHash        String            @unique @map("token_hash")
  permissions      AdminPermission[] @default([])
  status           AdminInviteStatus @default(PENDING)
  invitedById      String            @map("invited_by_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(3)
  emailConfirmedAt DateTime?         @map("email_confirmed_at") @db.Timestamptz(3)
  acceptedAt       DateTime?         @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?           @map("revoked_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  invitedBy        User              @relation("AdminInviteAuthor", fields: [invitedById], references: [id], onDelete: Restrict)
  account          User?             @relation("AdminInviteAccount", fields: [userId], references: [id], onDelete: SetNull)
  revokedBy        User?             @relation("AdminInviteRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([status, expiresAt])
  @@map("admin_invites")
}

/// Redefinição de senha de conta administrativa. Uso único, expiração curta e
/// token guardado apenas como hash.
model AdminPasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("admin_password_resets")
}

/// Recuperação supervisionada do segundo fator: um administrador pede, outro
/// com MANAGE_ADMINS aprova, e só então nasce o token de uso único.
model AdminMfaRecovery {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  status       AdminRecoveryStatus @default(PENDING)
  reason       String
  tokenHash    String?             @unique @map("token_hash")
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  reviewedById String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  reviewNote   String?             @map("review_note")
  completedAt  DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User                @relation("AdminRecoverySubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("AdminRecoveryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("admin_mfa_recoveries")
}
