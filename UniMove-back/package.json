{
  "name": "unimove-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST do UniMove",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:integration": "npm run build && node test/ride-queries.integration.cjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.2.6",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "cookie-parser": "latest",
    "dotenv": "latest",
    "expo-server-sdk": "^8.0.0",
    "helmet": "latest",
    "nodemailer": "^10.3.1",
    "otplib": "^13.6.0",
    "passport": "latest",
    "passport-jwt": "latest",
    "pdf-parse": "^2.4.5",
    "pg": "latest",
    "qrcode": "^1.5.4",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "twilio": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@eslint/js": "latest",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.6",
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/multer": "^2.3.0",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "latest",
    "@types/pg": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "globals": "latest",
    "jest": "latest",
    "prettier": "latest",
    "prisma": "^7.0.0",
    "source-map-support": "latest",
    "supertest": "latest",
    "ts-jest": "latest",
    "ts-loader": "latest",
    "ts-node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!generated/**",
      "!main.ts"
    ]
  }
}
