NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://unimove:unimove_dev@localhost:5432/unimove?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_EXPIRATION=30d
ALLOWED_INSTITUTIONAL_EMAIL_DOMAINS=ucb.edu.br
MATCHING_TIME_TOLERANCE_MINUTES=30
RIDE_REQUEST_EXPIRATION_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_PAGE_SIZE=100
# Painel administrativo (UniMove-admin). Origens separadas por vírgula.
ADMIN_PANEL_ORIGINS=http://localhost:5173
ADMIN_SESSION_MAX_HOURS=12
# Obrigatória em produção para cadastrar 2FA de administrador. Mínimo de 32 caracteres aleatórios.
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-third-32-random-characters

# 0: conexao direta local; 1: apenas o proxy de entrada do Render. Nunca true.
TRUST_PROXY_HOPS=0
# Producao exige TWO_FACTOR_ENCRYPTION_KEY com pelo menos 32 caracteres.
# Provisionamento administrativo e publicacao: docs/ADMIN_BACKEND_INTEGRATION.md.

# ---------------------------------------------------------------------------
# Gestao de identidade administrativa (convite, redefinicao, recuperacao).
# Sem ADMIN_PANEL_URL a API sobe normalmente; apenas as rotas que enviam link
# recusam com ADMIN_PANEL_URL_MISSING.
# ---------------------------------------------------------------------------
ADMIN_PANEL_URL=http://localhost:5173
ADMIN_INVITE_TTL_HOURS=72
ADMIN_PASSWORD_RESET_TTL_MINUTES=30
ADMIN_MFA_RECOVERY_TTL_HOURS=24
# Vazio: usa ALLOWED_INSTITUTIONAL_EMAIL_DOMAINS.
ADMIN_INVITE_EMAIL_DOMAINS=

# E-mail transacional de seguranca. smtp envia; log apenas registra destinatario
# mascarado e assunto; none nao tenta enviar. Vazio: smtp se houver SMTP_*, senao log.
MAIL_PROVIDER=log
MAIL_FROM=UniMove Admin <nao-responda@unimove.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
